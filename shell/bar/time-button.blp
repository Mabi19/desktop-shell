using Gtk 4.0;

template $TimeButton: Gtk.Button {
    name: "time-and-notifications";

    Box {
        spacing: 6;

        Label {
            label: bind template.service as <$TimeService>.time_short as <string>;
        }

        Separator {
            orientation: vertical;
        }

        Box {
            Image {
                icon-name: bind $get_bell_icon(
                    template.notifications as <$NotificationService>.dont-disturb
                    ) as <string>;
            }

            Revealer count_revealer {
                transition-type: swing_right;

                Label count_label {
                    margin-start: 4;
                }
            }
        }
    }
}
