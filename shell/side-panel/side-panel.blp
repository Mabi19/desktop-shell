using Gtk 4.0;

template $SidePanel: Gtk.Box {
    orientation: vertical;
    spacing: 8;

    $PreciseClock {
        active: bind template.active;
    }

    Calendar calendar {
        styles [
            "calendar",
        ]
    }

    Box {
        spacing: 8;

        Label {
            label: "Notifications";
            xalign: 0;
            hexpand: true;

            styles [
                "heading",
            ]
        }

        ToggleButton {
            icon-name: "streamline-sleep-symbolic";
            tooltip-text: "Do not disturb";
        }

        Button {
            label: "Clear";
            clicked => $clear_notification_center();
        }
    }

    ScrolledWindow {
        vexpand: true;

        $NotificationList {
            widget_type: storage;
            spacing: 8;
        }
    }
}
